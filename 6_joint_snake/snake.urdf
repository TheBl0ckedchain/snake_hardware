        <parent link="servo_link0"/>
        <child link="gear_link0"/>
        <origin xyz="0.1 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57"/>
    </joint>
    <link name="gear_link0">
        <visual>
            <geometry><cylinder radius="0.05" length="0.1"/></geometry>
            <material name="white"><color rgba="1 1 1 1"/></material>
