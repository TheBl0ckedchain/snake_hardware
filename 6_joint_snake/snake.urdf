<?xml version="1.0" ?>
<robot name="my_robot">

    <!-- ===================== SEGMENT 0 (head) ===================== -->
    <link name="servo_link0">
        <visual>
            <geometry><box size="0.1 0.1 0.1"/></geometry>
            <material name="red"><color rgba="1 0 0 1"/></material>
        </visual>
        <collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision>
        <inertial>
            <mass value="0.3"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
        </inertial>
    </link>

    <joint name="servo_wheel_l0" type="continuous">
        <parent link="servo_link0"/>
        <child link="wheel_l0"/>
        <origin xyz="0 0.055 -0.04" rpy="-1.57 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    <link name="wheel_l0">
        <visual>
            <geometry><cylinder radius="0.03" length="0.01"/></geometry>
            <material name="blue"><color rgba="0 0 1 1"/></material>
        </visual>
        <collision><geometry><cylinder radius="0.03" length="0.01"/></geometry></collision>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="2.33e-06" ixy="0.0" ixz="0.0" iyy="2.33e-06" iyz="0.0" izz="4.5e-06"/>
        </inertial>
    </link>

    <joint name="servo_wheel_r0" type="continuous">
        <parent link="servo_link0"/>
        <child link="wheel_r0"/>
        <origin xyz="0 -0.055 -0.04" rpy="1.57 0 0"/>
        <axis xyz="0 0 1"/>
